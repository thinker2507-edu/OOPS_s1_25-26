# Local settings. Start the app with start.bat (Windows) or start.sh (macOS/Linux).
APP_HOST=127.0.0.1
# Cloud uses provider settings only; never reads or creates a local secret file.
APP_CLOUD=false
APP_API_URL=
# Enable only behind Render's trusted reverse proxy.
APP_TRUST_PROXY=false
PORT=
# Used only by the explicit cloud initializer; provide private values in Render.
APP_CLOUD_ACCOUNT_PASSWORD=
APP_PORT=3000
APP_DATA_DIR=data
APP_SEED_SAMPLES=false
APP_COOKIE_SECURE=false
APP_SESSION_HOURS=12
APP_MONITOR_SECONDS=15
# Optional canonical recovery origin; blank uses localhost and APP_PORT.
APP_BASE_URL=
# local saves private .eml files in data/mailbox; resend sends real email.
EMAIL_DELIVERY_MODE=local
EMAIL_FROM=
RESEND_API_KEY=
APP_ADMIN_EMAIL=admin@local.test
APP_ADMIN_PASSWORD=RelayLocal!2026
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=relay
# Google OAuth. Put secrets only in ignored .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/google/callback
