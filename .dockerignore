# Docker's build context excludes private files independently of Git.
.git
.env
.env.*
!.env.example
secrets
.secrets
**/secrets
**/.secrets
**/*client_secret*.json
**/credentials.json
**/google-oauth.json
**/*service-account*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# The image installs dependencies and builds the frontend itself.
node_modules
**/node_modules
frontend/dist
data
backups
coverage
.nyc_output
**/*.log
**/*.tmp
**/*.sqlite3
**/*.sqlite3-*
**/*.db
**/*.bson
**/*.dump
**/*.eml

# Keep source/compiler/schema/licenses required by Dockerfile COPY instructions.
# Reports, tests, local launchers and archives are useful in Git, not in this image.
legacy
app
problem
report
tests
docs
bugs
changes.md
login.md
extract_brief.py
AGENTS.md
AGENTS.MD
**/*.[bB][aA][tT]
**/*.[sS][hH]
**/*.[mM][dD]
.vscode
.idea
.vercel
.render
.aws
.codex
.agents
.venv
.tools
**/__pycache__
**/*.pyc
environment-diagnostic.txt
git-owner-before.txt
